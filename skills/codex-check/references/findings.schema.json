{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adversarial review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "claims", "not_checked", "top_risks"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "file", "line", "defect", "failure_scenario", "evidence", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["blocker", "major", "minor"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "defect": { "type": "string" },
          "failure_scenario": { "type": "string" },
          "evidence": { "type": "string" },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "verdict", "reason"],
        "properties": {
          "claim": { "type": "string" },
          "verdict": { "enum": ["supported", "contradicted", "unproven"] },
          "reason": { "type": "string" }
        }
      }
    },
    "not_checked": {
      "type": "array",
      "items": { "type": "string" }
    },
    "top_risks": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
